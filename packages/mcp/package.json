  "description": "Keel MCP server — expose payment/wallet/data/account tools to AI agents (Claude/Cursor/etc.)",
  "license": "Apache-2.0",
  "homepage": "https://keel.codes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sftgroup/keelcodes.git",
